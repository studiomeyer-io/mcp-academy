{
  "name": "mcp-academy",
  "version": "0.5.0",
  "mcpName": "io.studiomeyer/academy",
  "description": "Live StudioMeyer Academy MCP: public learning and search, OAuth-scoped personal tools, explicit --offline legacy library.",
  "type": "module",
  "bin": {
    "mcp-academy": "./dist/index.js"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.scripts.json",
    "bundle": "node scripts/bundle-content.mjs",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/index.ts",
    "start:http": "node dist/index.js --http",
    "smoke": "node scripts/smoke-test.mjs",
    "db:schema": "node dist-scripts/scripts/migrate.js",
    "test": "node --import tsx --test tests/grants.test.ts tests/platform.test.ts tests/root-contract.test.ts",
    "test:auth-db": "node --import tsx --test tests/oauth-db.test.ts",
    "smoke:platform": "node scripts/platform-smoke.mjs",
    "test:migration-db": "node --import tsx --test tests/oauth-migration.test.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "studiomeyer",
    "academy",
    "education",
    "ai",
    "claude",
    "chatgpt",
    "cursor",
    "learning"
  ],
  "author": "StudioMeyer <info@studiomeyer.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/studiomeyer-io/mcp-academy.git"
  },
  "homepage": "https://studiomeyer.academy",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "overrides": {
    "@hono/node-server": "^2.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "gray-matter": "^4.0.3",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "optionalDependencies": {
    "pg": "^8.23.0",
    "nodemailer": "^10.3.1"
  }
}
